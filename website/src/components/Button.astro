---
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  class?: string;
  arrow?: boolean;
}
const {
  href,
  variant = 'primary',
  external = false,
  class: className = '',
  arrow = true,
} = Astro.props;
---

<a
  href={href}
  class:list={['button', `button-${variant}`, className]}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {arrow &&
    (external ? (
      <ArrowUpRight size={16} aria-hidden="true" />
    ) : (
      <ArrowRight size={16} aria-hidden="true" />
    ))}
</a>
